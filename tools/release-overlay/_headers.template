# Cloudflare Pages headers for the release (owner approved the header set 2026-11-10; Phase 3 changes 2026-11-12).
# tools/build-release.py writes this to release/heritage-hr64/_headers, replacing {CSP} with the page's own
# Content Security Policy plus frame-ancestors 'none', so the header and the meta tag cannot drift apart.
# Comment lines are removed by the build.
/*
  Strict-Transport-Security: max-age=604800
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=()
  Content-Security-Policy: {CSP}
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  ! Access-Control-Allow-Origin

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/band-90m.json
  Cache-Control: no-cache
/band-60m.json
  Cache-Control: no-cache
/band-49m.json
  Cache-Control: no-cache
/credits.json
  Cache-Control: no-cache
/geo/*
  Cache-Control: no-cache

/vendor/*
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=86400
